# Copy to .env for local XAMPP only. Do not commit .env.
# Production should provide these as server environment variables, not a web-accessible file.
BOMS_APP_ENV=local
BOMS_JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
BOMS_DB_HOST=127.0.0.1
BOMS_DB_PORT=3306
BOMS_DB_NAME=boms_evagas
BOMS_DB_USER=boms_app
BOMS_DB_PASS=replace_with_a_local_database_password
# Comma-separated exact browser origins allowed to make cross-origin API requests.
# Same-origin requests do not need CORS. Add the deployed HTTPS origin in production.
BOMS_CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
# Backups must be outside the public document root. Do not commit this value.
# BOMS_BACKUP_DIR=C:\xampp\backups\boms
# BOMS_MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
# BOMS_BACKUP_RETENTION_DAYS=30
# Road-routing provider. Default is router.project-osrm.org. Use an approved,
# reachable OSRM instance when your host/firewall blocks public routing services.
# BOMS_OSRM_BASE_URL=https://router.project-osrm.org
